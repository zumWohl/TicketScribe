{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src/renderer/src/lib/hash.ts",
    "src/renderer/src/lib/hash.worker.ts",
    "src/renderer/src/lib/redact.ts",
    "src/renderer/src/lib/redact.worker.ts",
    "src/shared/image.ts"
  ]
}
