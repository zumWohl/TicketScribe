{
  "name": "cardonetcapture",
  "version": "0.1.0",
  "description": "Automated work-log capture with local VLM analysis",
  "main": "out/main/index.js",
  "scripts": {
    "prestart": "npm run vendor:tesseract",
    "start": "electron-vite dev",
    "predev": "npm run vendor:tesseract",
    "dev": "electron-vite dev --inspect",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "test": "vitest run src/renderer/src/lib/redact.test.ts",
    "test:ocr": "electron test/run-ocr-verify.js",
    "test:ocr:offline": "electron test/run-ocr-verify-vendored.js --proxy-server=127.0.0.1:9",
    "test:ocr:dev": "electron test/run-ocr-verify-dev-server.js",
    "predist": "npm run vendor:tesseract",
    "dist": "electron-vite build && electron-builder --win nsis --x64 --publish never",
    "postinstall": "node scripts/vendor-tesseract.js && electron-builder install-app-deps",
    "vendor:tesseract": "node scripts/vendor-tesseract.js",
    "prebuild:vite": "npm run vendor:tesseract",
    "predev:vite": "npm run vendor:tesseract",
    "dev:vite": "electron-vite dev",
    "build:vite": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.worker.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "canvas": "^3.2.3",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^5.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  }
}
